---
import { categories } from '../data/tools';
import ToolCard from './ToolCard.astro';
import type { CategoryItem } from '../types';
import { ArrowRight, Layers } from 'lucide-react';

interface Props {
  selectedCategory?: string;
}

const { selectedCategory = 'all' } = Astro.props;

const displayedCategories: CategoryItem[] = selectedCategory === 'all'
  ? (categories as unknown as CategoryItem[])
  : (categories as unknown as CategoryItem[]).filter(c => c.slug === selectedCategory);
---

<section 
  id="tools-section"
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16"
>
  {displayedCategories.map((category) => {
    const isLiveCategory = category.status === 'live';

    return (
      <div 
        id={`category-section-${category.slug}`}
        class="scroll-mt-24 space-y-6"
      >
        {/* Category Section Header */}
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b" style="border-color: var(--border-subtle);">
          <div>
            <div class="flex items-center gap-2.5 mb-1.5">
              <span 
                class="w-3 h-3 rounded-full shrink-0" 
                style={`background-color: ${category.accentColor};`} 
              />
              <a
                href={`/${category.slug}`}
                class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight hover:underline transition-all"
                style="color: var(--text-primary);"
              >
                {category.name}
              </a>
              <span 
                class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full font-semibold"
                style={`background-color: ${isLiveCategory ? 'var(--badge-live-bg)' : 'var(--badge-soon-bg)'}; color: ${isLiveCategory ? 'var(--badge-live-text)' : 'var(--badge-soon-text)'};`}
              >
                {isLiveCategory ? 'READY TO USE' : 'COMING SOON'}
              </span>
            </div>
            <p 
              class="text-xs sm:text-sm max-w-2xl"
              style="color: var(--text-secondary);"
            >
              {category.description}
            </p>
          </div>

          {/* View all link linking to that category page */}
          <a
            id={`view-all-${category.slug}`}
            href={`/${category.slug}`}
            class="inline-flex items-center gap-1.5 text-xs font-bold tracking-wide transition-all group shrink-0 hover:underline"
            style={`color: ${category.accentColor};`}
          >
            <span>View all →</span>
            <ArrowRight size={14} class="group-hover:translate-x-1 transition-transform" />
          </a>
        </div>

        {/* Responsive Grid: 1 col on mobile, 2 on sm, 3 on md, 4 on xl */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
          {category.tools.map((tool) => (
            <a
              href={`/${category.slug}/${tool.slug}`}
              class="block focus:outline-none"
            >
              <ToolCard
                tool={{
                  ...tool,
                  categoryName: category.name,
                  categorySlug: category.slug,
                  categoryAccentColor: category.accentColor
                }}
                categoryAccentColor={category.accentColor}
                categoryName={category.name}
              />
            </a>
          ))}
        </div>

        {/* Section Bottom Footer Link */}
        <div class="flex justify-end pt-2">
          <a
            href={`/${category.slug}`}
            class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline"
            style={`color: ${category.accentColor};`}
          >
            <span>Explore all {category.tools.length} {category.name} →</span>
          </a>
        </div>
      </div>
    );
  })}
</section>
