---
import Logo from './Logo.astro';
import { categories } from '../data/tools';
import { ShieldCheck, Heart } from 'lucide-react';

const popularToolsList = [
  { name: 'Merge PDF', path: '/pdf-tools/merge-pdf' },
  { name: 'Compress Image', path: '/image-tools/image-compressor' },
  { name: 'JSON Formatter', path: '/developer-tools/json-formatter' },
  { name: 'QR Code Generator', path: '/developer-tools/qr-code-generator' },
  { name: 'Word Counter', path: '/text-tools/word-counter' },
  { name: 'Password Generator', path: '/developer-tools/password-generator' }
];
---

<footer 
  id="main-footer"
  class="w-full border-t transition-colors duration-200 mt-20"
  style={{
    backgroundColor: 'var(--bg-surface)',
    borderColor: 'var(--border-subtle)'
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      {/* Col 1: Logo + Tagline */}
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <Logo size="md" />
        </a>
        <p class="text-sm font-medium leading-relaxed" style={{ color: 'var(--text-secondary)' }}>
          Free browser-based tools that respect your privacy.
        </p>
        <div 
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs"
          style={{
            backgroundColor: 'var(--bg-input)',
            borderColor: 'var(--border-subtle)',
            color: 'var(--text-secondary)'
          }}
        >
          <ShieldCheck size={14} color="var(--accent)" />
          <span>100% Client-Side Processing</span>
        </div>
        <p class="text-xs pt-2" style={{ color: 'var(--text-muted)' }}>
          Contact: <a href="mailto:farhanaly.io3@gmail.com" class="hover:underline" style={{ color: 'var(--accent)' }}>farhanaly.io3@gmail.com</a>
        </p>
      </div>

      {/* Col 2: All 9 Category Links */}
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider mb-4" style={{ color: 'var(--text-primary)' }}>
          Tool Categories
        </h3>
        <ul class="space-y-2.5 text-sm">
          {categories.map((cat) => (
            <li>
              <a
                href={`/${cat.slug}`}
                class="hover:underline flex items-center justify-between w-full text-left transition-colors duration-150 group"
                style={{ color: 'var(--text-secondary)' }}
              >
                <span class="group-hover:translate-x-0.5 transition-transform duration-150">
                  {cat.name}
                </span>
                {cat.status === 'coming-soon' && (
                  <span 
                    class="text-[10px] px-1.5 py-0.5 rounded font-mono uppercase tracking-tight"
                    style={{
                      backgroundColor: 'var(--badge-soon-bg)',
                      color: 'var(--badge-soon-text)'
                    }}
                  >
                    Soon
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Col 3: Popular Tool Direct Links */}
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider mb-4" style={{ color: 'var(--text-primary)' }}>
          Popular Tools
        </h3>
        <ul class="space-y-2.5 text-sm">
          {popularToolsList.map((tool) => (
            <li>
              <a
                href={tool.path}
                class="hover:underline transition-colors duration-150 block text-left"
                style={{ color: 'var(--text-secondary)' }}
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Col 4: Platform & Legal Links */}
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider mb-4" style={{ color: 'var(--text-primary)' }}>
          Company & Legal
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="/about"
              class="hover:underline block text-left"
              style={{ color: 'var(--text-secondary)' }}
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class="hover:underline block text-left"
              style={{ color: 'var(--text-secondary)' }}
            >
              Blog
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="hover:underline block text-left"
              style={{ color: 'var(--text-secondary)' }}
            >
              Contact
            </a>
          </li>
          <li>
            <a
              href="/privacy-policy"
              class="hover:underline block text-left"
              style={{ color: 'var(--text-secondary)' }}
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="hover:underline block text-left"
              style={{ color: 'var(--text-secondary)' }}
            >
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div 
      class="border-t mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs"
      style={{ 
        borderColor: 'var(--border-subtle)',
        color: 'var(--text-muted)'
      }}
    >
      <p>© 2026 ToolGenie. All rights reserved.</p>
      <p class="flex items-center gap-1.5 font-medium text-center">
        <span>Made with</span>
        <Heart size={13} class="text-red-500 fill-red-500 inline" />
        <span>— your files never leave your browser.</span>
      </p>
    </div>
  </div>
</footer>
