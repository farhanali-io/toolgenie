---
import { categories } from '../data/tools';
import { LayoutGrid, ChevronLeft, ChevronRight, ExternalLink } from 'lucide-react';

interface Props {
  selectedCategory?: string;
}

const { selectedCategory = 'all' } = Astro.props;

const totalToolCount = categories.reduce((acc, cat) => acc + cat.tools.length, 0);
---

<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
  {/* Scroll controls for desktop */}
  <div class="flex items-center justify-between mb-3">
    <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">
      Browse by Category
    </span>
    <div class="hidden sm:flex items-center gap-1">
      <button
        id="category-scroll-left"
        type="button"
        class="p-1 rounded-md border hover:opacity-80 transition-opacity"
        style="background-color: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-secondary);"
        aria-label="Scroll categories left"
      >
        <ChevronLeft size={16} />
      </button>
      <button
        id="category-scroll-right"
        type="button"
        class="p-1 rounded-md border hover:opacity-80 transition-opacity"
        style="background-color: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-secondary);"
        aria-label="Scroll categories right"
      >
        <ChevronRight size={16} />
      </button>
    </div>
  </div>

  {/* Horizontally scrollable pills */}
  <div 
    id="category-scroll-container"
    class="flex items-center gap-2.5 overflow-x-auto pb-3 pt-1 scrollbar-none no-scrollbar select-none"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    {/* "All" Pill */}
    <button
      id="category-pill-all"
      data-category-slug="all"
      type="button"
      class={`toolgenie-hover-glow category-tab-pill shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border cursor-pointer ${
        selectedCategory === 'all' ? 'ring-2' : ''
      }`}
      style={`background-color: ${selectedCategory === 'all' ? 'var(--accent)' : 'var(--bg-surface)'}; color: ${selectedCategory === 'all' ? 'var(--accent-contrast)' : 'var(--text-primary)'}; border-color: ${selectedCategory === 'all' ? 'var(--accent)' : 'var(--border-subtle)'}; --category-accent: var(--accent); --category-glow: var(--accent-glow);`}
    >
      <LayoutGrid size={15} />
      <span>All Tools</span>
      <span 
        class="text-[11px] px-1.5 py-0.2 rounded-full font-mono font-normal opacity-80"
        style={`background-color: ${selectedCategory === 'all' ? 'rgba(255,255,255,0.2)' : 'var(--bg-input)'};`}
      >
        {totalToolCount}
      </span>
    </button>

    {/* 9 Category Pills with Signature Hover Glow */}
    {categories.map((cat) => {
      const isSelected = selectedCategory === cat.slug;
      const hex = cat.accentColor.replace('#', '');
      const r = parseInt(hex.substring(0, 2), 16) || 99;
      const g = parseInt(hex.substring(2, 4), 16) || 102;
      const b = parseInt(hex.substring(4, 6), 16) || 241;
      const categoryGlow = `rgba(${r}, ${g}, ${b}, 0.35)`;

      return (
        <div
          class={`toolgenie-hover-glow category-pill-wrapper shrink-0 inline-flex items-center rounded-xl border transition-all ${
            isSelected ? 'ring-2' : ''
          }`}
          style={`background-color: ${isSelected ? cat.accentColor : 'var(--bg-surface)'}; border-color: ${isSelected ? cat.accentColor : 'var(--border-subtle)'}; --category-accent: ${cat.accentColor}; --category-glow: ${categoryGlow};`}
        >
          <button
            id={`category-pill-${cat.slug}`}
            data-category-slug={cat.slug}
            type="button"
            class="category-tab-pill inline-flex items-center gap-2 px-3.5 py-2 text-xs sm:text-sm font-semibold cursor-pointer"
            style={`color: ${isSelected ? '#ffffff' : 'var(--text-primary)'};`}
          >
            {/* Category Color Dot */}
            <span 
              class="w-2 h-2 rounded-full shrink-0" 
              style={`background-color: ${isSelected ? '#ffffff' : cat.accentColor};`} 
            />
            <span class="whitespace-nowrap">{cat.name}</span>
            <span 
              class="text-[11px] px-1.5 py-0.2 rounded-full font-mono font-normal opacity-80 shrink-0"
              style={`background-color: ${isSelected ? 'rgba(255,255,255,0.25)' : 'var(--bg-input)'};`}
            >
              {cat.tools.length}
            </span>
          </button>

          {/* Direct link icon to category page */}
          <a
            href={`/${cat.slug}`}
            title={`Visit ${cat.name} page`}
            class="px-2 py-2 border-l hover:opacity-80 transition-opacity"
            style={`border-color: ${isSelected ? 'rgba(255,255,255,0.25)' : 'var(--border-subtle)'}; color: ${isSelected ? '#ffffff' : 'var(--text-muted)'};`}
            aria-label={`Open ${cat.name} category page`}
          >
            <ExternalLink size={12} />
          </a>
        </div>
      );
    })}
  </div>
</div>

<script>
  function setupCategoryScroll() {
    const container = document.getElementById('category-scroll-container');
    const leftBtn = document.getElementById('category-scroll-left');
    const rightBtn = document.getElementById('category-scroll-right');

    if (leftBtn && container) {
      leftBtn.onclick = () => {
        container.scrollBy({ left: -240, behavior: 'smooth' });
      };
    }

    if (rightBtn && container) {
      rightBtn.onclick = () => {
        container.scrollBy({ left: 240, behavior: 'smooth' });
      };
    }

    // Interactive category tab switching
    const pills = document.querySelectorAll<HTMLElement>('.category-tab-pill');
    pills.forEach((pill) => {
      pill.onclick = () => {
        const slug = pill.getAttribute('data-category-slug');
        if (!slug) return;
        
        const sections = document.querySelectorAll<HTMLElement>('[id^="category-section-"]');
        if (slug === 'all') {
          sections.forEach(s => s.style.display = '');
        } else {
          sections.forEach(s => {
            if (s.id === `category-section-${slug}`) {
              s.style.display = '';
              s.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
              s.style.display = 'none';
            }
          });
        }
      };
    });
  }

  setupCategoryScroll();
  document.addEventListener('astro:page-load', setupCategoryScroll);
</script>
