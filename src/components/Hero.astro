---
import { Search, X, Sparkles, ArrowRight, Shield } from 'lucide-react';
import { getAllTools } from '../data/tools';
import type { ToolItem } from '../types';

const allTools: ToolItem[] = getAllTools() as ToolItem[];

const quickSearchItems = ['Merge PDF', 'Compress Image', 'JSON Formatter', 'QR Code', 'Word Counter'];
---

<section 
  id="hero-section"
  class="relative pt-12 pb-16 sm:pt-20 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center"
>
  {/* Privacy Guarantee Badge */}
  <div 
    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border mb-6 text-xs font-semibold tracking-wide shadow-xs animate-in fade-in slide-in-from-top-4 duration-300"
    style="background-color: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-secondary);"
  >
    <Shield size={14} color="var(--accent)" />
    <span>100% Client-Side Engine</span>
    <span class="w-1 h-1 rounded-full opacity-40 bg-current"></span>
    <span class="hidden sm:inline">Zero Server Uploads</span>
    <span class="w-1 h-1 rounded-full opacity-40 bg-current hidden sm:inline"></span>
    <span class="font-mono text-[11px] font-bold" style="color: var(--accent);">Free Forever</span>
  </div>

  {/* Main Headline */}
  <h1 
    class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] mb-5 max-w-4xl mx-auto"
    style="color: var(--text-primary);"
  >
    Free online tools that run{' '}
    <span 
      class="relative inline-block"
      style="color: var(--accent);"
    >
      100% in your browser.
    </span>
  </h1>

  {/* Subtitle */}
  <p 
    class="text-lg sm:text-xl font-medium max-w-2xl mx-auto mb-10 leading-relaxed"
    style="color: var(--text-secondary);"
  >
    No uploads. No signup. No limits. Your files never leave your device — ever.
  </p>

  {/* Search Bar Container */}
  <div class="relative max-w-2xl mx-auto">
    <div 
      id="hero-search-wrapper"
      class="relative flex items-center rounded-2xl border transition-all duration-200 shadow-lg"
      style="background-color: var(--bg-surface); border-color: var(--border-strong); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.06);"
    >
      <div class="pl-4 sm:pl-5 flex items-center pointer-events-none">
        <Search 
          id="search-icon-hero"
          size={22} 
          class="transition-colors duration-150"
          color="var(--text-muted)"
        />
      </div>

      <input
        id="hero-search-input"
        type="text"
        placeholder="Search 50+ free tools (e.g. merge pdf, compress image, json)..."
        class="w-full py-4 sm:py-5 pl-3.5 pr-12 rounded-2xl bg-transparent text-sm sm:text-base font-medium focus:outline-none placeholder:font-normal"
        style="color: var(--text-primary);"
        autocomplete="off"
        aria-label="Search tools"
      />

      <button
        id="clear-search-button"
        type="button"
        class="hidden absolute right-4 p-1.5 rounded-full hover:opacity-80 transition-opacity focus:outline-none"
        style="background-color: var(--bg-input); color: var(--text-secondary);"
        aria-label="Clear search query"
      >
        <X size={15} />
      </button>
    </div>

    {/* Live Search Results Dropdown */}
    <div
      id="search-live-dropdown"
      class="hidden absolute left-0 right-0 mt-3 rounded-2xl border shadow-2xl p-2 z-50 max-h-96 overflow-y-auto text-left animate-in fade-in zoom-in-95 duration-150"
      style="background-color: var(--bg-elevated); border-color: var(--border-strong); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.45);"
    >
      <div class="px-3 py-2 border-b flex items-center justify-between text-xs" style="border-color: var(--border-subtle);">
        <span id="search-dropdown-count" class="font-semibold" style="color: var(--text-secondary);">
          Tools matching search
        </span>
        <span class="text-[11px]" style="color: var(--text-muted);">
          Use ↑ ↓ to navigate, Enter to view
        </span>
      </div>

      <div id="search-results-list" class="space-y-1 mt-1">
        {/* Populated dynamically via client script */}
      </div>

      <div id="search-no-results" class="hidden py-8 px-4 text-center">
        <Sparkles size={24} class="mx-auto mb-2 opacity-50" color="var(--accent)" />
        <p class="text-sm font-semibold" style="color: var(--text-primary);">
          No tools found
        </p>
        <p class="text-xs mt-1" style="color: var(--text-muted);">
          Try searching for "PDF", "Image", "Convert", or "Format".
        </p>
      </div>
    </div>
  </div>

  {/* Quick Search Chips */}
  <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs font-medium" style="color: var(--text-muted);">
    <span>Quick search:</span>
    {quickSearchItems.map((item) => (
      <button
        type="button"
        data-search-chip={item}
        class="quick-search-chip px-2.5 py-1 rounded-lg border hover:opacity-80 transition-colors cursor-pointer"
        style="background-color: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-secondary);"
      >
        {item}
      </button>
    ))}
  </div>
</section>

{/* Embed tools catalog for instantaneous client-side search */}
<script id="hero-all-tools-json" type="application/json" set:html={JSON.stringify(allTools)} />

<script>
  function initHeroSearch() {
    const dataEl = document.getElementById('hero-all-tools-json');
    if (!dataEl) return;

    let tools: any[] = [];
    try {
      tools = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }

    const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
    const wrapper = document.getElementById('hero-search-wrapper');
    const clearBtn = document.getElementById('clear-search-button');
    const dropdown = document.getElementById('search-live-dropdown');
    const countEl = document.getElementById('search-dropdown-count');
    const resultsList = document.getElementById('search-results-list');
    const noResults = document.getElementById('search-no-results');
    const searchIcon = document.getElementById('search-icon-hero');
    const chips = document.querySelectorAll<HTMLButtonElement>('.quick-search-chip');

    if (!input || !dropdown || !resultsList || !noResults || !clearBtn) return;

    let selectedIndex = 0;
    let currentResults: any[] = [];

    function renderResults(filtered: any[], query: string) {
      currentResults = filtered;
      selectedIndex = 0;

      if (query.trim().length === 0) {
        dropdown?.classList.add('hidden');
        clearBtn?.classList.add('hidden');
        return;
      }

      clearBtn?.classList.remove('hidden');
      dropdown?.classList.remove('hidden');

      if (countEl) {
        countEl.textContent = `${filtered.length} ${filtered.length === 1 ? 'tool' : 'tools'} matching "${query}"`;
      }

      if (filtered.length === 0) {
        resultsList!.innerHTML = '';
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
        resultsList!.innerHTML = filtered.map((tool, idx) => {
          const isLive = tool.status === 'live';
          return `
            <a
              href="/${tool.categorySlug}/${tool.slug}"
              data-index="${idx}"
              class="search-item flex items-center justify-between p-3 rounded-xl text-left transition-all duration-150 hover:bg-[var(--bg-input)] ${idx === 0 ? 'bg-[var(--bg-input)]' : ''}"
              style="color: var(--text-primary);"
            >
              <div class="flex items-center gap-3 min-w-0 pr-3">
                <div 
                  class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border"
                  style="background-color: var(--bg-surface); border-color: var(--border-subtle); color: ${tool.categoryAccentColor || 'var(--accent)'};"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-bold truncate">${tool.name}</span>
                    <span 
                      class="text-[10px] px-1.5 py-0.5 rounded font-mono font-medium shrink-0"
                      style="background-color: ${isLive ? 'var(--badge-live-bg)' : 'var(--badge-soon-bg)'}; color: ${isLive ? 'var(--badge-live-text)' : 'var(--badge-soon-text)'};"
                    >
                      ${isLive ? 'LIVE' : 'COMING SOON'}
                    </span>
                  </div>
                  <p class="text-xs truncate mt-0.5" style="color: var(--text-secondary);">${tool.shortDescription}</p>
                </div>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          `;
        }).join('');
      }
    }

    function doSearch(val: string) {
      const query = val.toLowerCase().trim();
      if (!query) {
        renderResults([], '');
        return;
      }
      const matches = tools.filter(tool => 
        tool.name.toLowerCase().includes(query) ||
        tool.shortDescription.toLowerCase().includes(query) ||
        (tool.categoryName && tool.categoryName.toLowerCase().includes(query)) ||
        tool.slug.toLowerCase().includes(query)
      );
      renderResults(matches, val);
    }

    input.oninput = (e: any) => {
      doSearch(e.target.value);
    };

    input.onfocus = () => {
      if (wrapper) {
        wrapper.style.borderColor = 'var(--accent)';
        wrapper.style.boxShadow = '0 10px 25px -5px var(--accent-glow)';
      }
      if (searchIcon) {
        searchIcon.style.color = 'var(--accent)';
      }
      if (input.value.trim().length > 0) {
        doSearch(input.value);
      }
    };

    input.onblur = () => {
      if (wrapper) {
        wrapper.style.borderColor = 'var(--border-strong)';
        wrapper.style.boxShadow = '0 4px 20px -2px rgba(0,0,0,0.06)';
      }
      if (searchIcon) {
        searchIcon.style.color = 'var(--text-muted)';
      }
      setTimeout(() => {
        dropdown?.classList.add('hidden');
      }, 250);
    };

    input.onkeydown = (e) => {
      if (!currentResults.length) return;
      const items = resultsList?.querySelectorAll<HTMLElement>('.search-item') || [];

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % currentResults.length;
        items.forEach((item, idx) => {
          item.classList.toggle('bg-[var(--bg-input)]', idx === selectedIndex);
        });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
        items.forEach((item, idx) => {
          item.classList.toggle('bg-[var(--bg-input)]', idx === selectedIndex);
        });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (currentResults[selectedIndex]) {
          const tool = currentResults[selectedIndex];
          window.location.href = `/${tool.categorySlug}/${tool.slug}`;
        }
      } else if (e.key === 'Escape') {
        dropdown?.classList.add('hidden');
      }
    };

    clearBtn.onclick = () => {
      input.value = '';
      renderResults([], '');
      input.focus();
    };

    chips.forEach(chip => {
      chip.onclick = () => {
        const val = chip.getAttribute('data-search-chip') || '';
        input.value = val;
        input.focus();
        doSearch(val);
      };
    });
  }

  initHeroSearch();
  document.addEventListener('astro:page-load', initHeroSearch);
</script>
