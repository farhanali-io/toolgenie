---
import { MousePointerClick, Cpu, Download, ShieldCheck } from 'lucide-react';

const steps = [
  {
    num: '01',
    title: 'Select',
    subtitle: 'Choose your tool',
    description: 'Pick from 45+ specialized utilities for documents, graphics, code, and media. Zero sign-up, waitlists, or payment required.',
    icon: MousePointerClick
  },
  {
    num: '02',
    title: 'Process in Browser',
    subtitle: '100% local computation',
    description: 'All operations execute inside your browser tab using WebAssembly, WebCodecs, and WebCrypto. Your confidential files never touch external servers.',
    icon: Cpu,
    highlight: true
  },
  {
    num: '03',
    title: 'Download',
    subtitle: 'Instant results',
    description: 'Save your transformed or optimized files directly to your machine. No wait queues, artificial speed limits, or added watermarks.',
    icon: Download
  }
];
---

<section 
  id="how-it-works-section"
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 my-8 border-y"
  style="border-color: var(--border-subtle); background-color: var(--bg-surface);"
>
  <div class="text-center max-w-3xl mx-auto mb-14">
    <div 
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-3 border"
      style="background-color: var(--bg-input); border-color: var(--border-subtle); color: var(--accent);"
    >
      <ShieldCheck size={14} />
      <span>Client-Side Architecture</span>
    </div>
    <h2 
      class="font-heading text-3xl sm:text-4xl font-extrabold tracking-tight mb-3"
      style="color: var(--text-primary);"
    >
      How ToolGenie Works
    </h2>
    <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">
      Unlike traditional conversion sites that upload sensitive documents to third-party cloud servers, ToolGenie brings the server to your browser.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
    {steps.map((step, idx) => {
      const Icon = step.icon;
      return (
        <div 
          class={`rounded-2xl p-6 sm:p-7 border relative flex flex-col justify-between transition-all duration-200 ${
            step.highlight ? 'ring-1' : ''
          }`}
          style={`background-color: var(--bg-page); border-color: ${step.highlight ? 'var(--accent)' : 'var(--border-subtle)'}; box-shadow: ${step.highlight ? '0 10px 25px -5px var(--accent-glow)' : 'none'};`}
        >
          <div>
            {/* Step badge and step number */}
            <div class="flex items-center justify-between mb-5">
              <div 
                class="w-12 h-12 rounded-xl flex items-center justify-center border"
                style="background-color: var(--bg-surface); border-color: var(--border-subtle); color: var(--accent);"
              >
                <Icon size={24} />
              </div>
              <span 
                class="font-mono text-2xl font-black opacity-30 tracking-tighter"
                style="color: var(--text-primary);"
              >
                {step.num}
              </span>
            </div>

            <div class="mb-2">
              <span 
                class="text-[11px] font-bold uppercase tracking-wider block mb-1"
                style="color: var(--accent);"
              >
                Step {idx + 1}: {step.subtitle}
              </span>
              <h3 
                class="font-heading text-xl font-bold tracking-tight"
                style="color: var(--text-primary);"
              >
                {step.title}
              </h3>
            </div>

            <p 
              class="text-xs sm:text-sm leading-relaxed mt-2"
              style="color: var(--text-secondary);"
            >
              {step.description}
            </p>
          </div>

          {step.highlight && (
            <div 
              class="mt-6 pt-3 border-t text-[11px] font-semibold flex items-center gap-1.5"
              style="border-color: var(--border-subtle); color: var(--accent);"
            >
              <ShieldCheck size={13} />
              <span>Files never leave your device.</span>
            </div>
          )}
        </div>
      );
    })}
  </div>
</section>
