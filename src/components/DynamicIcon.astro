---
import * as LucideIcons from 'lucide-react';

interface Props {
  name: string;
  class?: string;
  className?: string;
  size?: number;
  color?: string;
}

const {
  name,
  class: classProp,
  className,
  size = 22,
  color
} = Astro.props;

const customClass = classProp || className || '';

// Access Lucide icon dynamically
const Icons = LucideIcons as Record<string, any>;
const IconComponent = Icons[name] || LucideIcons.Wrench;
---

<IconComponent 
  size={size} 
  className={customClass} 
  color={color}
  aria-hidden="true" 
/>
