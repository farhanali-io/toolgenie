---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PopularStrip from '../components/PopularStrip.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import ToolGrid from '../components/ToolGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhyToolGenie from '../components/WhyToolGenie.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolGenie',
  url: 'https://toolgenie.online',
  description: 'Free online tools running 100% in your browser with zero server file uploads.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://toolgenie.online/#hero-search-input',
    'query-input': 'required name=search_term_string'
  }
};
---

<Layout
  title="ToolGenie — Free Browser-Based Tools (100% Client-Side)"
  description="Free online tools that run 100% in your browser. No uploads, no signup, no limits. Convert, edit, and optimize your files with complete privacy."
  jsonLd={jsonLd}
>
  <Hero />
  <PopularStrip />
  <div id="tools-section-wrapper">
    <CategoryTabs />
    <ToolGrid />
  </div>
  <HowItWorks />
  <WhyToolGenie />
</Layout>
