---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { PopularStrip } from '../components/PopularStrip';
import { HomeToolExplorer } from '../components/HomeToolExplorer';
import { HowItWorks } from '../components/HowItWorks';
import { WhyToolGenie } from '../components/WhyToolGenie';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolGenie',
  url: 'https://toolgenie.online',
  description: 'Free online tools running 100% in your browser with zero server file uploads.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://toolgenie.online/#hero-search-input',
    'query-input': 'required name=search_term_string'
  }
};
---

<Layout
  title="ToolGenie — Free Browser-Based Tools (100% Client-Side)"
  description="Free online tools that run 100% in your browser. No uploads, no signup, no limits. Convert, edit, and optimize your files with complete privacy."
  canonicalUrl="https://toolgenie.online"
  jsonLd={jsonLd}
>
  <Hero client:load />
  <PopularStrip client:idle />
  <HomeToolExplorer client:load />
  <HowItWorks />
  <WhyToolGenie />
</Layout>
