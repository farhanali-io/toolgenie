---
import Layout from '../layouts/Layout.astro';
import { ShieldCheck, Cpu, Lock, Zap, ArrowLeft, Heart, CheckCircle2 } from 'lucide-react';
---

<Layout
  title="About ToolGenie — 100% Client-Side Private Utility Platform"
  description="Learn why ToolGenie was built: a zero-upload, privacy-first web utility suite executing 100% in your browser using modern WebAssembly."
  canonicalUrl="https://toolgenie.online/about"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-8">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline"
        style={{ color: 'var(--accent)' }}
      >
        <ArrowLeft size={14} />
        <span>Back to All Tools</span>
      </a>
    </div>

    {/* Header */}
    <div class="border-b pb-8 mb-12" style={{ borderColor: 'var(--border-subtle)' }}>
      <div 
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold mb-4 border"
        style={{
          backgroundColor: 'var(--bg-surface)',
          borderColor: 'var(--border-subtle)',
          color: 'var(--accent)'
        }}
      >
        <ShieldCheck size={14} />
        <span>About the Platform</span>
      </div>
      <h1 
        class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight mb-4"
        style={{ color: 'var(--text-primary)' }}
      >
        Tools that respect your files.
      </h1>
      <p 
        class="text-lg sm:text-xl font-medium leading-relaxed"
        style={{ color: 'var(--text-secondary)' }}
      >
        ToolGenie was engineered to solve a fundamental flaw with web utilities: you shouldn&apos;t have to sacrifice confidential data to merge a PDF or convert an image.
      </p>
    </div>

    {/* Content Sections */}
    <div class="space-y-12 text-sm sm:text-base leading-relaxed" style={{ color: 'var(--text-secondary)' }}>
      {/* Section 1: The Problem with Traditional Tools */}
      <section class="space-y-4">
        <h2 class="font-heading text-2xl font-bold tracking-tight" style={{ color: 'var(--text-primary)' }}>
          The Problem with Traditional Cloud Tools
        </h2>
        <p>
          Every day, millions of people upload tax returns, employee contracts, medical records, and private source code to online converter sites. What many users don&apos;t realize is that traditional conversion services transmit those files to unknown cloud servers, store them in temporary folders, and often process them using third-party APIs.
        </p>
        <p>
          Even with promised 24-hour deletion windows, server-side processing leaves sensitive data vulnerable to intercept attacks, server misconfigurations, and unauthorized training datasets.
        </p>
      </section>

      {/* Section 2: How ToolGenie Is Different */}
      <section 
        class="rounded-2xl p-6 sm:p-8 border"
        style={{
          backgroundColor: 'var(--bg-surface)',
          borderColor: 'var(--border-subtle)'
        }}
      >
        <div class="flex items-center gap-3 mb-4">
          <div 
            class="w-10 h-10 rounded-xl flex items-center justify-center border"
            style={{
              backgroundColor: 'var(--bg-input)',
              borderColor: 'var(--border-subtle)',
              color: 'var(--accent)'
            }}
          >
            <Cpu size={20} />
          </div>
          <h2 class="font-heading text-xl sm:text-2xl font-bold tracking-tight" style={{ color: 'var(--text-primary)' }}>
            The Browser-as-a-Processor Architecture
          </h2>
        </div>
        <p class="mb-4">
          ToolGenie brings the computation directly to your browser tab. Through modern browser technologies like <strong>WebAssembly (WASM)</strong>, <strong>WebCodecs</strong>, <strong>Web Workers</strong>, and the <strong>Web Crypto API</strong>, we compile powerful native binary engines (like PDF manipulation, image encoders, and audio decoders) to run locally on your device&apos;s CPU and GPU.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          {[
            'Files never leave your device memory',
            'Zero wait time in remote upload queues',
            'Works completely offline once loaded',
            'No account, subscription, or paywall'
          ].map((item) => (
            <div class="flex items-center gap-2 text-xs font-semibold" style={{ color: 'var(--text-primary)' }}>
              <CheckCircle2 size={16} class="text-emerald-500 shrink-0" />
              <span>{item}</span>
            </div>
          ))}
        </div>
      </section>

      {/* Section 3: Core Guiding Pillars */}
      <section class="space-y-6">
        <h2 class="font-heading text-2xl font-bold tracking-tight" style={{ color: 'var(--text-primary)' }}>
          Our Guiding Principles
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div 
            class="rounded-xl p-5 border"
            style={{
              backgroundColor: 'var(--bg-surface)',
              borderColor: 'var(--border-subtle)'
            }}
          >
            <Lock size={20} class="mb-2" color="var(--accent)" />
            <h3 class="font-heading text-base font-bold mb-1" style={{ color: 'var(--text-primary)' }}>100% Privacy</h3>
            <p class="text-xs leading-relaxed">No tracking of document contents, zero server logs, and zero telemetry on personal files.</p>
          </div>
          <div 
            class="rounded-xl p-5 border"
            style={{
              backgroundColor: 'var(--bg-surface)',
              borderColor: 'var(--border-subtle)'
            }}
          >
            <Zap size={20} class="mb-2" color="var(--accent)" />
            <h3 class="font-heading text-base font-bold mb-1" style={{ color: 'var(--text-primary)' }}>Hardware Speed</h3>
            <p class="text-xs leading-relaxed">Operate at memory bus speeds without network latency bottlenecks or throttling.</p>
          </div>
          <div 
            class="rounded-xl p-5 border"
            style={{
              backgroundColor: 'var(--bg-surface)',
              borderColor: 'var(--border-subtle)'
            }}
          >
            <Heart size={20} class="mb-2" color="var(--accent)" />
            <h3 class="font-heading text-base font-bold mb-1" style={{ color: 'var(--text-primary)' }}>No Artificial Limits</h3>
            <p class="text-xs leading-relaxed">No watermarks, no conversion countdowns, and no prompts asking you to upgrade to Pro.</p>
          </div>
        </div>
      </section>

      {/* Section 4: Contact & Maintainer */}
      <section 
        class="border-t pt-8 mt-12 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        style={{ borderColor: 'var(--border-subtle)' }}
      >
        <div>
          <h3 class="font-heading text-lg font-bold" style={{ color: 'var(--text-primary)' }}>
            Have suggestions or tool requests?
          </h3>
          <p class="text-xs sm:text-sm mt-0.5">
            We are continuously building new browser-first utilities.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-semibold text-sm transition-opacity hover:opacity-90 shrink-0"
          style={{
            backgroundColor: 'var(--accent)',
            color: 'var(--accent-contrast)'
          }}
        >
          Contact Us
        </a>
      </section>
    </div>
  </div>
</Layout>
