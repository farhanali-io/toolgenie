---
import Layout from '../layouts/Layout.astro';
import { BookOpen, Calendar, Clock, ArrowRight, ArrowLeft } from 'lucide-react';

const blogPosts = [
  {
    slug: 'merge-pdf-without-uploading',
    title: 'How to Merge PDF Files Without Uploading Them',
    excerpt: 'Combine PDFs in your browser. Files stay on your device—no account, no watermark, no server copy. Steps, checks, and common snags.',
    category: 'Guides & Privacy',
    date: 'March 23, 2026',
    readTime: '6 min read'
  }
];
---

<Layout
  title="Blog & Insights — ToolGenie"
  description="Technical deep dives, architectural guides, and privacy insights from the engineering team behind ToolGenie."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-8">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline"
        style={{ color: 'var(--accent)' }}
      >
        <ArrowLeft size={14} />
        <span>Back to All Tools</span>
      </a>
    </div>

    {/* Header */}
    <div class="border-b pb-8 mb-12" style={{ borderColor: 'var(--border-subtle)' }}>
      <div 
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold mb-4 border"
        style={{
          backgroundColor: 'var(--bg-surface)',
          borderColor: 'var(--border-subtle)',
          color: 'var(--accent)'
        }}
      >
        <BookOpen size={14} />
        <span>Engineering & Insights</span>
      </div>
      <h1 
        class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight mb-4"
        style={{ color: 'var(--text-primary)' }}
      >
        ToolGenie Blog
      </h1>
      <p 
        class="text-lg font-medium leading-relaxed max-w-2xl"
        style={{ color: 'var(--text-secondary)' }}
      >
        Articles on client-side web technologies, WebAssembly, security best practices, and browser performance optimization.
      </p>
    </div>

    {/* Post List */}
    <div class="space-y-6">
      {blogPosts.map((post) => (
        <article
          class="rounded-2xl border p-6 sm:p-8 transition-all duration-200 hover:shadow-md"
          style={{
            backgroundColor: 'var(--bg-surface)',
            borderColor: 'var(--border-subtle)'
          }}
        >
          <div class="flex items-center gap-3 text-xs font-medium mb-3" style={{ color: 'var(--text-muted)' }}>
            <span 
              class="px-2.5 py-0.5 rounded-md font-semibold text-[11px]"
              style={{
                backgroundColor: 'var(--bg-input)',
                color: 'var(--accent)'
              }}
            >
              {post.category}
            </span>
            <span class="flex items-center gap-1">
              <Calendar size={13} />
              {post.date}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <Clock size={13} />
              {post.readTime}
            </span>
          </div>

          <h2 
            class="font-heading text-xl sm:text-2xl font-bold tracking-tight mb-2"
            style={{ color: 'var(--text-primary)' }}
          >
            {post.title}
          </h2>

          <p class="text-sm leading-relaxed mb-6" style={{ color: 'var(--text-secondary)' }}>
            {post.excerpt}
          </p>

          <a
            href={`/blog/${post.slug}/`}
            class="inline-flex items-center gap-1.5 text-xs font-bold hover:underline"
            style={{ color: 'var(--accent)' }}
          >
            <span>Read full article</span>
            <ArrowRight size={13} />
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
